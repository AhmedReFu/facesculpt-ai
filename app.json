{
  "expo": {
    "name": "facesculpt-ai",
    "slug": "facesculpt-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ahmedrefu.facesculptai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {},
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ahmedrefu.facesculptai"
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "e5a2b487-7f24-4e3f-8c80-e91fe8eb0f83"
      }
    },
    "plugins": [
      "expo-font"
    ]
  }
}
