{
  "expo": {
    "name": "FaceSculpt AI",
    "slug": "facesculpt-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/logo.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.AhmedReFu.facesculptai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow camera access to scan your face"
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.AhmedReFu.facesculptai",
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "6defaa9e-c262-4d16-8ecd-87d1316b2d1c"
      }
    },
    "plugins": [
      "expo-camera",
      [
        "expo-build-properties",
        {
          "android": {
            "enableHermes": true
          },
          "ios": {
            "enableHermes": true
          }
        }
      ]
    ]
  }
}
